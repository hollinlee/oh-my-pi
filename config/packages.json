  "architecture": {
    "description": "oh-my-pi feature organization strategy",
    "principles": [
      "Skills and lightweight extensions stay in oh-my-pi",
      "Heavy features with complex implementation move to separate repos",
      "Separate packages are installed via npm/git as dependencies"
    ],
    "stayInOhMyPi": {
      "description": "Lightweight features kept in oh-my-pi repo",
      "skills": [
        "alignment/ - Goal alignment methodology",
        "design-pi-capability/ - Pi capability design guidance",
        "diagnosing-bugs/ - Debug workflow guidance",
        "github-workflow/ - GitHub workflow guidance (pairs with separate extension)",
        "find-skills/ - Skill discovery",
        "improvement-suggestions/ - Improvement suggestion collection"
      ],
      "extensions": [
        "compact-tool-renderer.ts - Compact tool display",
        "image-result-limiter.ts - Image result limiting",
        "task-timer.ts - Task timing",
        "user-prompt.ts - User prompt customization",
        "rtk-adapter.ts - RTK integration",
        "phase-trace.ts - Phase tracking with tool summary (keep as optional feature)"
      ],
      "core": [
        "system/APPEND_SYSTEM.md - Personal communication rules",
        "scripts/ - Setup/teardown scripts",
        "config/packages.json - Package management manifest"
      ]
    },
    "separateRepos": {
      "description": "Heavy features extracted to separate repos/packages",
      "highPriority": [
        {
          "name": "@oh-my-pi/remote-devices",
          "includes": ["extensions/remote-devices/", "skills/remote-devices/"],
          "reason": "2169 lines, complex SSH management, batch operations, device aliases",
          "reference": ["pi-ssh-remote", "@oresk/pi-remote-tools"],
          "status": "planned"
        },
        {
          "name": "@oh-my-pi/github-workflow",
          "includes": ["extensions/github-workflow/", "extensions/work-issue-autopilot.ts", "skills/github-workflow/"],
          "reason": "Complete issue/PR autopilot, complex state management",
          "reference": ["pi-github", "pi-pr-review"],
          "status": "planned"
        }
      ],
      "mediumPriority": [
        {
          "name": "@oh-my-pi/serial-devices",
          "includes": ["extensions/serial-devices/", "skills/serial-devices/"],
          "reason": "Professional serial management, may share architecture with remote-devices",
          "status": "planned",
          "note": "Consider merging with @oh-my-pi/remote-devices"
        },
        {
          "name": "@oh-my-pi/goal-management",
          "includes": ["skills/alignment/ (future redesign)"],
          "reason": "Unified goal management: alignment → planning → tracking → completion audit",
          "status": "planned",
          "note": "Needs separate discussion to design alignment + rpiv-todo + pi-goal-x integration strategy"
        }
      ],
      "toRemove": [
        {
          "path": "extensions/model-task/",
          "reason": "3548 lines, only 3 references, default disabled, overlaps with pi-subagents",
          "linesOfCode": 3548,
          "references": 3,
          "status": "removed",
          "removedDate": "2025-01-XX"
        },
        {
          "path": "extensions/phase-trace.ts + extensions/phase-trace/",
          "reason": "906 lines, mainly UI styling, should be unified with status-bar redesign",
          "linesOfCode": 906,
          "status": "removed",
          "removedDate": "2025-01-XX"
        },
        {
          "path": "extensions/rtk-adapter.ts",
          "reason": "Replaced by npm:pi-rtk-optimizer (more complete)",
          "status": "to-be-removed"
        },
        {
          "path": "extensions/permissions/",
          "reason": "Permission integration removed at user request",
          "status": "removed"
        }
      ],
      "underEvaluation": [
        {
          "path": "extensions/model-task/",
          "reason": "Need to clarify purpose before deciding",
          "status": "under-evaluation"
        }
      ]
    }
  }
