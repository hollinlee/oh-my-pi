{
  "name": "oh-my-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Shareable pi setup package with local tools, web search, and capability-design workflows.",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "personal-config",
    "extensions",
    "skills",
    "prompt-templates"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "skills",
    "prompts",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "teardown": "node scripts/teardown.mjs",
    "pi-empty-comments": "node scripts/patch-pi-empty-comments.mjs",
    "test": "node --test extensions/**/*.test.ts",
    "typecheck": "pi --no-extensions -e . --list-models >/dev/null"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-prompt-intercept/src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.17",
    "pi-prompt-intercept": "git+ssh://git@github.com/ichigyu/pi-prompt-intercept.git",
    "yauzl": "^3.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "fflate": "^0.8.3"
  }
}
