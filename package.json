{
  "name": "oh-my-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Shareable pi setup package with local tools, web search, and capability-design workflows.",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "personal-config",
    "extensions",
    "skills",
    "prompt-templates"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "skills",
    "prompts",
    "system",
    "scripts",
    "config",
    "README.md"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "install-append-system": "node scripts/install-append-system.mjs",
    "teardown": "node scripts/teardown.mjs",
    "test": "node --test extensions/**/*.test.ts scripts/*.test.mjs",
    "typecheck": "pi --no-extensions -e . --list-models >/dev/null"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/@ff-labs/pi-fff/src/index.ts",
      "./node_modules/@juicesharp/rpiv-pi/extensions",
      "./node_modules/pi-lens/dist/index.js",
      "./node_modules/pi-prompt-intercept/src/index.ts",
      "./node_modules/pi-rtk-adapter/src/index.ts",
      "./node_modules/pi-subagents/index.ts",
      "./node_modules/pi-ui-extensions/extensions/index.ts",
      "./node_modules/pi-web-access/dist",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/@juicesharp/rpiv-pi/skills",
      "./node_modules/pi-lens/skills",
      "./node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./prompts",
      "./node_modules/pi-subagents/prompts"
    ],
    "themes": [
      "./node_modules/pi-ui-extensions/themes/cc-dark.json",
      "./node_modules/pi-ui-extensions/themes/cc-light.json"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.17",
    "@ff-labs/pi-fff": "^0.11.0",
    "@juicesharp/rpiv-pi": "^2.11.0",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "node-pty": "^1.1.0",
    "pi-lens": "*",
    "pi-prompt-intercept": "git+ssh://git@github.com/ichigyu/pi-prompt-intercept.git",
    "pi-rtk-adapter": "git+https://github.com/hollinlee/pi-rtk-adapter.git",
    "pi-subagents": "^0.55.0",
    "pi-ui-extensions": "git+https://github.com/hollinlee/pi-ui-extensions.git",
    "pi-web-access": "^0.31.0",
    "yauzl": "^3.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/yauzl": "^3.4.0",
    "fflate": "^0.8.3"
  }
}
